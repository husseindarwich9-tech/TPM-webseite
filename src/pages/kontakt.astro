---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import AnfrageAssistent from '../components/AnfrageAssistent.astro';
import Split from '../components/Split.astro';
import Icon from '../components/Icon.astro';
import { firma } from '../data/firma';
import { breadcrumbSchema } from '../data/seo';

const crumbs = [{ href: '/kontakt/', label: 'Kontakt' }];
---
<Base
  title="Kontakt – TPM Bau GmbH Berlin"
  description="Kontakt zur TPM Bau GmbH: Gustav-Müller-Platz 3, 10829 Berlin. Telefon +49 30 4699 8895, E-Mail info@tpm-bau.de – oder direkt online anfragen."
  schema={[breadcrumbSchema(crumbs)]}
  compactFooter
>
  <PageHero
    blatt="08"
    kicker="Kontakt"
    title="Wir sind|für Sie *da.*"
    lead="Rufen Sie uns an, schreiben Sie uns oder beschreiben Sie Ihr Vorhaben direkt im Anfrage-Assistenten."
    crumbs={crumbs}
  />

  <section class="contact">
    <div class="wrap contact__grid">
      <a href={firma.telefonHref} class="cbox" data-reveal>
        <span class="cbox__icon"><Icon name="phone" /></span>
        <span class="mono">Telefon</span>
        <span class="cbox__value">{firma.telefon}</span>
        <span class="cbox__note"><span class="placeholder-text">{firma.oeffnungszeiten}</span></span>
      </a>
      <a href={firma.emailHref} class="cbox" data-reveal>
        <span class="cbox__icon"><Icon name="mail" /></span>
        <span class="mono">E-Mail</span>
        <span class="cbox__value">{firma.email}</span>
        <span class="cbox__note">Für Anfragen, Rückfragen und Bewerbungen</span>
      </a>
      <a href={firma.osmUrl} class="cbox" target="_blank" rel="noopener" data-reveal>
        <span class="cbox__icon"><Icon name="pin" /></span>
        <span class="mono">Adresse</span>
        <span class="cbox__value">{firma.adresse.strasse}<br />{firma.adresse.plz} {firma.adresse.ort}</span>
        <span class="cbox__note">Auf OpenStreetMap ansehen <Icon name="external" class="cbox__ext" /><span class="visually-hidden"> (öffnet in neuem Tab)</span></span>
      </a>
    </div>
  </section>

  <section class="section" id="anfrage">
    <div class="wrap form-wrap">
      <div class="form-wrap__head">
        <p class="label">Anfrage-Assistent</p>
        <Split as="h2" class="h2" text="Beschreiben Sie|Ihr *Vorhaben.*" />
        <p class="muted" data-reveal>In sechs kurzen Schritten, mit Fotos und Wunschtermin. Dauert etwa zwei Minuten.</p>
      </div>
      <AnfrageAssistent />
    </div>
  </section>
</Base>

<style>
  .contact {
    background: var(--ink);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .contact__grid {
    display: grid;
    gap: 1px;
    background: var(--line-light);
    border: 1px solid var(--line-light);
  }
  .cbox {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: 2rem;
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
    transition: background-color 0.3s;
  }
  .cbox:hover {
    background: var(--ink-2);
  }
  .cbox__icon {
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    background: var(--blue);
    margin-bottom: 1rem;
    clip-path: polygon(0 0, calc(100% - 0.75rem) 0, 100% 0.75rem, 100% 100%, 0 100%);
  }
  .cbox .mono {
    color: var(--sky);
  }
  .cbox__value {
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    font-weight: 680;
    font-stretch: 110%;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .cbox__note {
    color: var(--muted-light);
    font-size: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .cbox :global(.cbox__ext) {
    width: 0.9rem;
    height: 0.9rem;
  }
  @media (min-width: 900px) {
    .contact__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .form-wrap {
    display: grid;
    gap: 3rem;
  }
  .form-wrap__head {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  @media (min-width: 1100px) {
    .form-wrap {
      grid-template-columns: 1fr 2.2fr;
      gap: 5rem;
    }
    .form-wrap__head {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      align-self: start;
    }
  }
</style>

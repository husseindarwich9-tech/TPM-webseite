---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Split from '../components/Split.astro';
import Icon from '../components/Icon.astro';
import Bild from '../components/Bild.astro';
import { firma } from '../data/firma';
import { PlugZap } from 'lucide-react';
import { breadcrumbSchema } from '../data/seo';

const crumbs = [{ href: '/karriere/', label: 'Karriere & Ausbildung' }];
const mailBewerbung = `${firma.emailHref}?subject=${encodeURIComponent('Bewerbung bei der TPM Bau GmbH')}`;
// Ausgebildet wird derzeit nur im Elektrohandwerk: Nur dort hat TPM einen Meister im Betrieb.
const mailAusbildung = `${firma.emailHref}?subject=${encodeURIComponent('Bewerbung Ausbildung Elektroniker/-in')}`;
---
<Base
  title="Karriere & Ausbildung in Berlin"
  description="Arbeiten bei der TPM Bau GmbH in Berlin: Fachkräfte, Bauleiter und Projektmanager im Innenausbau. Ausbildung zum Elektroniker / zur Elektronikerin."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    blatt="06"
    kicker="Karriere & Ausbildung"
    title="Bauen Sie|mit *uns.*"
    lead="Wir sind ein Team aus Fachkräften, Bauleitern und Projektmanagern. Wenn Sie mit Leidenschaft bauen und Verantwortung übernehmen möchten, sprechen Sie uns an."
    crumbs={crumbs}
  >
    <div class="hero-ctas" data-reveal>
      <a href={mailBewerbung} class="btn">Jetzt bewerben <Icon name="arrow" /></a>
    </div>
  </PageHero>

  <section class="section">
    <div class="wrap jobs">
      <div>
        <p class="label">Offene Stellen</p>
        <Split as="h2" class="h2" text="Aktuelle|*Stellen.*" />
      </div>
      <div class="jobs__list" data-reveal>
        <div class="job job--placeholder">
          <span class="placeholder-text">[PLATZHALTER: Offene Stellen mit Titel, Umfang und Anforderungen]</span>
          <p class="muted">
            Solange hier keine Stelle steht, freuen wir uns über Ihre Initiativbewerbung, für alle unsere Gewerke und
            für Bauleitung und Projektmanagement.
          </p>
          <a href={mailBewerbung} class="arrow-link">Initiativ bewerben <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section on-ink">
    <div class="wrap ausb">
      <div>
        <p class="label">Ausbildung</p>
        <Split as="h2" class="h2" text="Ihr Einstieg ins|*Elektrohandwerk.*" />
        <p class="muted ausb__lead" data-reveal>
          Wir bilden im Elektrohandwerk aus. Ihre Ausbildung begleitet unser Elektromeister, direkt auf unseren
          Baustellen in Berlin.
        </p>
      </div>
      <article class="beruf" data-reveal>
        <span class="beruf__icon" aria-hidden="true"><PlugZap size={30} strokeWidth={1.6} /></span>
        <p class="mono beruf__kicker">Ausbildungsberuf</p>
        <h3 class="beruf__titel">Elektroniker/-in</h3>
        <p class="beruf__fach">Fachrichtung Energie- und Gebäudetechnik</p>
        <dl class="beruf__fakten">
          <div><dt>Dauer</dt><dd>3,5 Jahre (Regelausbildungszeit)</dd></div>
          <div><dt>Ausbilder</dt><dd>Elektromeister im Betrieb</dd></div>
          <div><dt>Einsatzort</dt><dd>Baustellen in Berlin</dd></div>
          <div><dt>Beginn</dt><dd><span class="placeholder-text">[PLATZHALTER: Ausbildungsbeginn]</span></dd></div>
        </dl>
        <a href={mailAusbildung} class="btn">Für die Ausbildung bewerben <Icon name="arrow" /></a>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="wrap why">
      <Bild slot="karriere" ratio="4 / 3" />
      <div class="why__text">
        <p class="label">Was Sie erwartet</p>
        <Split as="h2" class="h2" text="Ein Team,|das *zusammen­arbeitet.*" />
        <ul role="list" class="points" data-reveal>
          <li>Arbeit in einem Team, in dem alle Gewerke zusammenkommen</li>
          <li>Projekte für Privatkunden, Gewerbe und Hausverwaltungen in Berlin</li>
          <li>Klare Abläufe und Ansprechpartner in Bauleitung und Projektmanagement</li>
        </ul>
        <p data-reveal><span class="placeholder-text">[PLATZHALTER: Leistungen für Mitarbeitende, z. B. Vergütung, Arbeitszeiten, Weiterbildung]</span></p>
      </div>
    </div>
  </section>

  <section class="section section--tight on-blue apply">
    <div class="wrap apply__inner">
      <div>
        <p class="apply__title">So bewerben Sie sich</p>
        <p class="apply__text">
          Schicken Sie uns eine kurze E-Mail mit Lebenslauf und gegebenenfalls Zeugnissen an
          <a href={mailBewerbung}>{firma.email}</a>, oder rufen Sie uns an: <a href={firma.telefonHref}>{firma.telefon}</a>.
        </p>
      </div>
      <a href={mailBewerbung} class="btn btn--lg">Bewerbung senden <Icon name="mail" /></a>
    </div>
  </section>
</Base>

<style>
  .hero-ctas {
    margin-top: 2.5rem;
  }
  .jobs,
  .ausb,
  .why {
    display: grid;
    gap: 3rem;
  }
  .jobs .h2,
  .ausb .h2 {
    margin-top: 1.25rem;
  }
  .job {
    padding: 2rem;
    border: 1px dashed rgba(26, 99, 176, 0.5);
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .ausb__lead {
    margin: 1.5rem 0;
    max-width: 46ch;
  }
  .beruf {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
    padding: clamp(1.5rem, 3.5vw, 2.75rem);
    background: var(--ink-2);
    border: 1px solid var(--line-light-strong);
  }
  .beruf__icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: 0.75rem;
    background: var(--blue);
    color: var(--paper);
    clip-path: polygon(0 0, calc(100% - 0.75rem) 0, 100% 0.75rem, 100% 100%, 0 100%);
  }
  .beruf__kicker {
    color: var(--sky);
  }
  .beruf__titel {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 760;
    font-stretch: 110%;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .beruf__fach {
    color: var(--muted-light);
    font-weight: 560;
  }
  .beruf__fakten {
    width: 100%;
    margin: 1rem 0 1.5rem;
    border-top: 1px solid var(--line-light);
  }
  .beruf__fakten div {
    display: grid;
    grid-template-columns: minmax(5.5rem, 7.5rem) 1fr;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line-light);
  }
  .beruf__fakten dt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sky);
    padding-top: 0.2rem;
  }
  .beruf__fakten dd {
    margin: 0;
  }
  .why__text {
    display: grid;
    gap: 1.5rem;
  }
  .points {
    margin: 0;
    border-top: 1px solid var(--line-strong);
  }
  .points li {
    padding: 1rem 0 1rem 1.75rem;
    border-bottom: 1px solid var(--line);
    position: relative;
  }
  .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.7rem;
    width: 1rem;
    height: 1px;
    background: var(--blue);
  }
  @media (min-width: 1000px) {
    .jobs,
    .ausb,
    .why {
      grid-template-columns: 1fr 1.3fr;
      gap: 6rem;
      align-items: center;
    }
  }
  .apply__inner {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .apply__title {
    font-size: clamp(1.6rem, 3vw, 2.6rem);
    font-weight: 760;
    font-stretch: 112%;
    letter-spacing: -0.02em;
  }
  .apply__text {
    margin-top: 0.75rem;
    max-width: 56ch;
  }
  .apply__text a {
    color: inherit;
    text-underline-offset: 0.2em;
  }
  @media (min-width: 900px) {
    .apply__inner {
      grid-template-columns: 1fr auto;
    }
  }
</style>

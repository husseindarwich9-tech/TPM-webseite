---
import Base from '../layouts/Base.astro';
import Split from '../components/Split.astro';
import Icon from '../components/Icon.astro';
import BauSequenz from '../components/BauSequenz.astro';
import TradeDrawing from '../components/TradeDrawing.astro';
import ServiceIndex from '../components/ServiceIndex.astro';
import Quotes from '../components/Quotes.astro';
import Marquee from '../components/Marquee.astro';
import { Picture } from 'astro:assets';
import { firma } from '../data/firma';
import { bild } from '../data/bilder';

const foto = bild('startfoto');
const intro =
  'TPM steht für Technical Project Management. Wir verbinden Handwerk mit Projektsteuerung: Ein Team aus Fachkräften, Bauleitern und Projektmanagern übernimmt alle Gewerke Ihres Vorhabens, von der ersten Abstimmung bis zur sauberen Übergabe.';

const ablauf = [
  {
    titel: 'Anfrage',
    text: 'Sie beschreiben Ihr Vorhaben über den Anfrage-Assistenten, per E-Mail oder am Telefon. Fotos helfen beim Einschätzen.',
  },
  {
    titel: 'Abstimmung',
    text: 'Wir klären offene Fragen, schauen uns die Situation an und stimmen Umfang, Ablauf und Termine mit Ihnen ab.',
  },
  {
    titel: 'Angebot',
    text: 'Sie erhalten ein nachvollziehbares Angebot für Ihr konkretes Vorhaben.',
  },
  {
    titel: 'Umsetzung',
    text: 'Unser Team führt die Arbeiten aus und koordiniert alle beteiligten Gewerke. Sie haben einen festen Ansprechpartner.',
  },
  {
    titel: 'Abnahme',
    text: 'Gemeinsame Abnahme und eine saubere Übergabe der Baustelle.',
  },
];
---
<Base
  title="TPM Bau GmbH Berlin – Innenausbau & alle Gewerke aus einer Hand"
  description="TPM Bau GmbH aus Berlin: Innenausbau, Trockenbau, Maler-, Fliesen- und Bodenarbeiten, Elektro und Sanitär – alle Gewerke aus einer Hand für Privat, Gewerbe und Hausverwaltungen."
>
  <BauSequenz />

  <!-- ═════════ AUFTRAGGEBER ═════════ -->
  <section class="clients on-ink" aria-labelledby="clients-title">
    <div class="wrap clients__head">
      <h2 id="clients-title" class="label">Auftraggeber (Auswahl)</h2>
    </div>
    <Marquee items={[...firma.auftraggeber]} />
    <div class="wrap">
      <ul role="list" class="facts">
        <li><span class="mono">Gegründet</span>{firma.gruendung} in Berlin</li>
        <li><span class="mono">Leistungen</span>12 Gewerke, ein Ansprechpartner</li>
        <li><span class="mono">Für</span>Privat, Gewerbe, Hausverwaltungen</li>
        <li><span class="mono">Mitglied</span>Handwerkskammer Berlin · BG BAU</li>
      </ul>
    </div>
  </section>

  <!-- ═════════ INTRO ═════════ -->
  <section class="section intro" aria-labelledby="intro-title">
    <div class="wrap intro__grid">
      <div class="intro__side">
        <h2 id="intro-title" class="label">Wer wir sind</h2>
        <ul role="list" class="intro__roles" data-reveal>
          {firma.team.map((r, i) => (
            <li><span class="mono">0{i + 1}</span>{r}</li>
          ))}
        </ul>
      </div>
      <div>
        <p class="intro__text" data-scrub-words>
          {intro.split(' ').map((w) => <span class="wd">{w} </span>)}
        </p>
        <div class="intro__links" data-reveal>
          <a href="/ueber-uns/" class="arrow-link">Mehr über TPM <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
    {foto.src && (
      <div class="wrap">
        <figure class="intro__foto" data-reveal-clip>
          <Picture
            src={foto.src}
            alt={foto.alt}
            formats={['avif', 'webp']}
            widths={[480, 800, 1200, 1600].filter((w) => w <= foto.src!.width)}
            sizes="(min-width: 1000px) 60vw, 100vw"
          />
          <figcaption class="mono">Team TPM · Berlin</figcaption>
        </figure>
      </div>
    )}
  </section>

  <!-- ═════════ LEISTUNGEN ═════════ -->
  <section class="section section--flush-top services" aria-labelledby="services-title">
    <div class="wrap">
      <div class="services__head">
        <p class="label">Leistungen</p>
        <Split as="h2" id="services-title" class="h2" text="Zwölf Gewerke.|*Ein Ansprechpartner.*" />
        <p class="services__lead muted" data-reveal>
          Einzeln beauftragt oder als Gesamtpaket: Wir stimmen die Gewerke aufeinander ab, damit Ihr Vorhaben ohne
          Leerlauf und doppelte Wege vorankommt.
        </p>
      </div>
      <ServiceIndex />
    </div>
  </section>

  <!-- ═════════ ZIELGRUPPEN ═════════ -->
  <section class="section audiences on-ink" aria-labelledby="aud-title">
    <div class="wrap">
      <p class="label">Für wen wir arbeiten</p>
      <Split as="h2" id="aud-title" class="h2 audiences__title" text="Zwei Auftraggeber.|*Ein Anspruch.*" />
      <div class="audiences__grid">
        <article class="aud" data-reveal>
          <div class="aud__axis" aria-hidden="true">A</div>
          <TradeDrawing slug="innenausbau" class="aud__drawing" />
          <h3 class="h3">Privatkunden</h3>
          <p class="muted">
            Sie sanieren Ihre Wohnung, renovieren vor dem Einzug oder brauchen kurzfristig Hilfe bei einem Schaden.
            Wir übernehmen die Arbeiten und koordinieren alle Gewerke, damit Sie sich nicht um jeden Handwerker
            einzeln kümmern müssen.
          </p>
          <ul role="list" class="aud__list">
            <li>Sanierung und Modernisierung</li>
            <li>Renovierung vor Ein- oder Auszug</li>
            <li>Badsanierung</li>
            <li>Hilfe bei akuten Schäden</li>
          </ul>
          <a href="/anfrage/?kunde=privat" class="arrow-link">Anfrage als Privatkunde <Icon name="arrow" /></a>
        </article>
        <article class="aud" data-reveal>
          <div class="aud__axis" aria-hidden="true">B</div>
          <TradeDrawing slug="trockenbau" class="aud__drawing" />
          <h3 class="h3">Gewerbe &amp; Hausverwaltungen</h3>
          <p class="muted">
            Sie betreuen Bestandsobjekte, bauen Gewerbeflächen aus oder brauchen einen verlässlichen Partner für
            laufende Instandhaltung. Bauleiter und Projektmanager steuern die Arbeiten und halten Sie auf dem
            Laufenden.
          </p>
          <ul role="list" class="aud__list">
            <li>Ausbau von Büro-, Laden- und Gastronomieflächen</li>
            <li>Instandsetzung bei Mieterwechsel</li>
            <li>Laufende Kleinreparaturen</li>
            <li>Rückbau und Entrümpelung</li>
          </ul>
          <a href="/gewerbe/" class="arrow-link">Mehr für Gewerbekunden <Icon name="arrow" /></a>
        </article>
      </div>
    </div>
  </section>

  <!-- ═════════ WERTE (horizontal) ═════════ -->
  <section class="values on-blue" data-hscroll aria-labelledby="values-title">
    <div class="values__track" data-hscroll-track>
      <div class="values__intro">
        <p class="label">Wofür wir stehen</p>
        <h2 id="values-title" class="h2">Drei Werte, an denen Sie uns messen können.</h2>
        <p class="values__hint mono" aria-hidden="true">Weiterscrollen <Icon name="arrow" /></p>
      </div>
      {firma.werte.map((w, i) => (
        <article class="value">
          <span class="value__nr mono">0{i + 1} / 03</span>
          <h3 class="value__title">{w.titel}</h3>
          {'zusatz' in w && <p class="value__add">{w.zusatz}</p>}
          <p class="value__text">{w.text}</p>
          <div class="value__tool" aria-hidden="true">
            {i === 0 && (
              <>
                <svg class="waage" viewBox="0 0 260 64" data-waage>
                  <rect x="2" y="12" width="256" height="40" rx="4" fill="#f3f1ec" stroke="#0a1626" stroke-width="1.5" />
                  <rect x="2" y="12" width="22" height="40" rx="4" fill="#0a1626" />
                  <rect x="236" y="12" width="22" height="40" rx="4" fill="#0a1626" />
                  <path d={Array.from({ length: 26 }, (_, k) => `M${32 + k * 8} 52 V${k % 5 === 0 ? 44 : 48}`).join(' ')} stroke="#0a1626" stroke-width="1" />
                  <rect x="96" y="19" width="68" height="22" rx="11" fill="#bfe0f5" stroke="#0a1626" stroke-width="1.3" />
                  <ellipse class="waage__blase" cx="130" cy="30" rx="9" ry="6.5" fill="#ffffff" stroke="#1a63b0" stroke-width="1.2" />
                  <path d="M118 19 V41 M142 19 V41" stroke="#0a1626" stroke-width="1.3" />
                </svg>
                <p class="value__lot mono is-lot" data-lot>Im Lot</p>
              </>
            )}
            {i === 1 && (
              <svg class="lagen" viewBox="0 0 280 190" data-lagen>
                {[0, 1, 2].map((k) => (
                  <g class="lage">
                    <rect x="40" y="50" width="170" height="120" fill="rgba(243,241,236,0.12)" stroke="rgba(243,241,236,0.75)" stroke-width="1" />
                    {k === 0 && <path d="M58 70 H190 V150 H58 Z M58 112 H120 M150 70 V112" fill="none" stroke="#f3f1ec" stroke-width="1.6" />}
                    {k === 1 && <path d="M58 160 H190 M58 156 V164 M124 156 V164 M190 156 V164 M200 70 V150 M196 70 H204 M196 150 H204" fill="none" stroke="#bfe0f5" stroke-width="1" />}
                    {k === 2 && (
                      <g fill="none" stroke="#f3f1ec" stroke-width="1.2">
                        <circle cx="90" cy="92" r="7" /><path d="M85 87 L95 97 M95 87 L85 97" />
                        <circle cx="160" cy="132" r="5" /><path d="M90 99 V128 H155" stroke-dasharray="3 3" />
                      </g>
                    )}
                  </g>
                ))}
              </svg>
            )}
            {i === 2 && (
              <svg class="schraube" viewBox="0 0 120 170" data-schraube>
                <defs>
                  <clipPath id="schaft-clip"><rect x="51" y="40" width="18" height="74" /></clipPath>
                </defs>
                <g class="schraube__teil">
                  <path d="M60 114 L52 114 L60 132 L68 114 Z" fill="#c8d0d8" stroke="#0a1626" stroke-width="1.2" stroke-linejoin="round" />
                  <rect x="52" y="40" width="16" height="74" fill="#c8d0d8" stroke="#0a1626" stroke-width="1.2" />
                  <g clip-path="url(#schaft-clip)">
                    <g class="schraube__gewinde">
                      <path d={Array.from({ length: 40 }, (_, k) => `M50 ${30 + k * 7} L70 ${24 + k * 7}`).join(' ')} stroke="#0a1626" stroke-width="1.2" />
                    </g>
                  </g>
                  <path d="M34 26 H86 L80 40 H40 Z" fill="#e3e8ec" stroke="#0a1626" stroke-width="1.2" stroke-linejoin="round" />
                  <rect x="57" y="26" width="6" height="5" fill="#0a1626" />
                </g>
                <rect x="6" y="96" width="108" height="56" rx="2" fill="#c99e6c" stroke="#0a1626" stroke-width="1.2" />
                <path d="M12 108 C40 102 70 114 108 106 M12 122 C46 116 76 128 108 120 M12 138 C38 132 72 144 108 136" fill="none" stroke="#9a7148" stroke-width="1.2" />
              </svg>
            )}
          </div>
        </article>
      ))}
    </div>
    <div class="values__progress" aria-hidden="true"><span data-hscroll-progress></span></div>
  </section>

  <!-- ═════════ ABLAUF ═════════ -->
  <section class="section process" aria-labelledby="process-title">
    <div class="wrap process__grid">
      <div class="process__head">
        <p class="label">Ablauf</p>
        <Split as="h2" id="process-title" class="h2" text="Vom Erstkontakt|bis zur *Abnahme.*" />
        <p class="muted process__lead" data-reveal>
          So läuft ein Auftrag bei uns ab. Sie wissen bei jedem Schritt, was als Nächstes passiert und wer
          zuständig ist.
        </p>
        <a href="/anfrage/" class="btn process__cta" data-reveal>Schritt 1 starten <Icon name="arrow" /></a>
      </div>
      <div class="steps-wrap" data-progress>
      <ol role="list" class="steps">
        {ablauf.map((s, i) => (
          <li class="step" data-step>
            <span class="rule" aria-hidden="true"><span class="rule__num">{(i + 1) * 20}</span></span>
            <span class="step__nr mono">0{i + 1}</span>
            <div>
              <h3 class="h3">{s.titel}</h3>
              <p class="muted">{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
      </div>
    </div>
  </section>

  <!-- ═════════ KUNDENSTIMMEN ═════════ -->
  <Quotes />

  <!-- ═════════ PARTNER ═════════ -->
  <section class="section partners" aria-labelledby="partners-title">
    <div class="wrap partners__grid">
      <div>
        <p class="label">Netzwerk</p>
        <Split as="h2" id="partners-title" class="h2" text="Starke Partner|im *Rücken.*" />
        <p class="muted partners__lead" data-reveal>
          Wir arbeiten mit etablierten Fachhändlern und Herstellern zusammen und sind in den Verbänden des
          Handwerks organisiert.
        </p>
        <a href="/partner/" class="arrow-link" data-reveal>Alle Partner <Icon name="arrow" /></a>
      </div>
      <div class="partners__lists">
        <div data-reveal>
          <h3 class="mono partners__sub">Zulieferer (Auswahl)</h3>
          <ul role="list" class="namelist">
            {firma.zulieferer.map((z) => <li>{z}</li>)}
          </ul>
        </div>
        <div data-reveal>
          <h3 class="mono partners__sub">Mitglied</h3>
          <ul role="list" class="namelist namelist--strong">
            {firma.mitgliedschaften.map((m) => <li>{m}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── Auftraggeber ── */
  .clients {
    padding-block: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--line-light);
  }
  .clients__head {
    margin-bottom: 1.75rem;
  }
  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem 1.5rem;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-light);
    font-size: 0.9rem;
    line-height: 1.35;
  }
  .facts li {
    display: grid;
    gap: 0.3rem;
  }
  .facts .mono {
    color: var(--sky);
    font-size: 0.66rem;
  }
  @media (min-width: 900px) {
    .facts {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .intro__foto {
    margin: clamp(3rem, 6vw, 5rem) 0 0 auto;
    width: fit-content;
    max-width: 100%;
    border: 1px solid var(--line-strong);
    padding: 0.6rem;
    background: var(--paper-2);
    overflow: hidden;
  }
  .intro__foto :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 80svh;
  }
  .intro__foto figcaption {
    margin-top: 0.6rem;
    color: var(--muted);
    font-size: 0.65rem;
  }

  /* ── Intro ── */
  .intro__grid {
    display: grid;
    gap: 2.5rem;
  }
  .intro__roles {
    margin-top: 2rem;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }
  .intro__roles li {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
    font-weight: 600;
    font-stretch: 110%;
  }
  .intro__roles .mono {
    color: var(--blue);
  }
  .intro__text {
    font-size: clamp(1.55rem, 3.3vw, 3rem);
    line-height: 1.18;
    font-weight: 560;
    font-stretch: 106%;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }
  .intro__links {
    margin-top: 2.5rem;
  }
  @media (min-width: 1000px) {
    .intro__grid {
      grid-template-columns: 1fr 2.6fr;
      gap: 5rem;
    }
  }

  /* ── Leistungen ── */
  .section--flush-top {
    padding-top: 0;
  }
  .services__head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }
  .services__lead {
    max-width: 46ch;
  }
  @media (min-width: 1000px) {
    .services__head {
      grid-template-columns: 1.6fr 1fr;
      align-items: end;
    }
    .services__head .label {
      grid-column: 1 / -1;
    }
  }

  /* ── Zielgruppen ── */
  .audiences__title {
    margin-top: 1.25rem;
  }
  .audiences__grid {
    margin-top: clamp(3rem, 6vw, 5rem);
    display: grid;
    border-top: 1px solid var(--line-light);
  }
  .aud {
    position: relative;
    display: grid;
    gap: 1.25rem;
    align-content: start;
    padding: 2.5rem 0 3rem;
    border-bottom: 1px solid var(--line-light);
  }
  .aud__axis {
    position: absolute;
    top: 2.5rem;
    right: 0;
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--line-light-strong);
    border-radius: 50%;
    font-family: var(--font-mono);
    color: var(--sky);
  }
  .aud__drawing {
    width: 7rem;
    color: var(--paper);
    --trade-bg: var(--ink);
    --trade-sw: 1.6;
    margin-bottom: 0.5rem;
  }
  .aud .muted {
    max-width: 52ch;
  }
  .aud__list {
    margin: 0.5rem 0 1rem;
    display: grid;
    gap: 0;
  }
  .aud__list li {
    padding: 0.7rem 0 0.7rem 1.6rem;
    border-top: 1px solid var(--line-light);
    position: relative;
  }
  .aud__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.25rem;
    width: 0.8rem;
    height: 1px;
    background: var(--sky);
  }
  .aud .arrow-link {
    justify-self: start;
  }
  @media (min-width: 900px) {
    .audiences__grid {
      grid-template-columns: 1fr 1fr;
      border-bottom: 1px solid var(--line-light);
    }
    .aud {
      padding: 3.5rem 4rem 3.5rem 0;
      border-bottom: 0;
    }
    .aud + .aud {
      padding-left: 4rem;
      padding-right: 0;
      border-left: 1px solid var(--line-light);
    }
    .aud__axis {
      right: 3rem;
      top: 3.5rem;
    }
    .aud + .aud .aud__axis {
      right: 0;
    }
  }

  /* ── Werte ── */
  .values {
    position: relative;
    overflow: hidden;
  }
  .values__track {
    display: grid;
    gap: 0;
  }
  .values__intro,
  .value {
    padding: clamp(4rem, 9vw, 6rem) var(--gutter);
  }
  .values__intro .h2 {
    margin-top: 1.25rem;
    max-width: 14ch;
  }
  .values__intro .label {
    color: var(--paper);
  }
  .values__hint {
    display: none;
  }
  .value {
    border-top: 1px solid rgba(243, 241, 236, 0.22);
    display: grid;
    align-content: center;
    gap: 1rem;
  }
  .value__nr {
    color: var(--paper);
  }
  .value__title {
    font-size: clamp(2.2rem, 10.5vw, 10rem);
    line-height: 0.95;
    font-weight: 800;
    font-stretch: 100%;
    letter-spacing: -0.04em;
  }
  .value__add {
    font-size: clamp(1.15rem, 2vw, 1.6rem);
    font-weight: 560;
    font-stretch: 110%;
    color: var(--paper);
    opacity: 1;
  }
  .value__tool {
    margin-top: 1.25rem;
    display: grid;
    gap: 0.6rem;
    justify-items: start;
  }
  .waage {
    width: min(260px, 70vw);
  }
  .lagen {
    width: min(260px, 70vw);
  }
  .schraube {
    width: 96px;
  }
  .value__lot {
    color: var(--paper);
    opacity: 0.45;
    transition: opacity 0.3s;
  }
  .value__lot:global(.is-lot) {
    opacity: 1;
  }
  .value__lot::before {
    content: '';
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.5rem;
    border-radius: 50%;
    background: #9be29b;
    vertical-align: middle;
  }
  .value__text {
    max-width: 44ch;
    font-size: 1.1rem;
    color: rgba(243, 241, 236, 0.9);
  }
  .values__progress {
    display: none;
  }
  /* Horizontal nur mit aktiven Animationen; sonst stehen die Werte untereinander */
  @media (min-width: 900px) {
    .value__title {
      font-size: clamp(4rem, 10vw, 11rem);
    }
    :global(html.motion-ready) .values {
      height: 100vh;
    }
    :global(html.motion-ready) .values__track {
      display: flex;
      height: 100%;
      width: max-content;
      align-items: stretch;
    }
    :global(html.motion-ready) .values__intro {
      width: 42vw;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-left: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    }
    :global(html.motion-ready) .values__hint {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      margin-top: 3rem;
      color: rgba(243, 241, 236, 0.8);
    }
    :global(html.motion-ready) .value {
      width: 78vw;
      border-top: 0;
      border-left: 1px solid rgba(243, 241, 236, 0.22);
      padding-inline: 5vw;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        'nr nr'
        'title title'
        'add tool'
        'text tool';
      column-gap: 4vw;
      align-content: center;
    }
    :global(html.motion-ready) .value__nr {
      grid-area: nr;
    }
    :global(html.motion-ready) .value__title {
      grid-area: title;
      font-size: clamp(4rem, 6.8vw, 8.5rem);
    }
    :global(html.motion-ready) .value__add {
      grid-area: add;
      align-self: end;
    }
    :global(html.motion-ready) .value__text {
      grid-area: text;
      align-self: start;
    }

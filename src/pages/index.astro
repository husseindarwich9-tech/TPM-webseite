---
import Base from '../layouts/Base.astro';
import Split from '../components/Split.astro';
import Icon from '../components/Icon.astro';
import BauSequenz from '../components/BauSequenz.astro';
import TradeDrawing from '../components/TradeDrawing.astro';
import ServiceIndex from '../components/ServiceIndex.astro';
import Quotes from '../components/Quotes.astro';
import { Picture } from 'astro:assets';
import { firma } from '../data/firma';
import { bild } from '../data/bilder';

const foto = bild('startfoto');
const intro =
  'TPM steht für Technical Project Management. Wir verbinden Handwerk mit Projektsteuerung: Ein Team aus Fachkräften, Bauleitern und Projektmanagern übernimmt alle Gewerke Ihres Vorhabens, von der ersten Abstimmung bis zur sauberen Übergabe.';

const ablauf = [
  {
    titel: 'Anfrage',
    text: 'Sie beschreiben Ihr Vorhaben über den Anfrage-Assistenten, per E-Mail oder am Telefon. Fotos helfen beim Einschätzen.',
  },
  {
    titel: 'Abstimmung',
    text: 'Wir klären offene Fragen, schauen uns die Situation an und stimmen Umfang, Ablauf und Termine mit Ihnen ab.',
  },
  {
    titel: 'Angebot',
    text: 'Sie erhalten ein nachvollziehbares Angebot für Ihr konkretes Vorhaben.',
  },
  {
    titel: 'Umsetzung',
    text: 'Unser Team führt die Arbeiten aus und koordiniert alle beteiligten Gewerke. Sie haben einen festen Ansprechpartner.',
  },
  {
    titel: 'Abnahme',
    text: 'Gemeinsame Abnahme und eine saubere Übergabe der Baustelle.',
  },
];
---
<Base
  title="TPM Bau GmbH Berlin – Innenausbau & alle Gewerke aus einer Hand"
  description="TPM Bau GmbH aus Berlin: Innenausbau, Trockenbau, Maler-, Fliesen- und Bodenarbeiten, Elektro und Sanitär – alle Gewerke aus einer Hand für Privat, Gewerbe und Hausverwaltungen."
>
  <BauSequenz />

  <!-- ═════════ AUFTRAGGEBER ═════════ -->
  <section class="clients on-ink" aria-labelledby="clients-title">
    <div class="wrap clients__head">
      <h2 id="clients-title" class="label">Auftraggeber (Auswahl)</h2>
    </div>
    <div class="wrap">
      <ul role="list" class="clients__list">
        {firma.auftraggeber.map((n) => <li>{n}</li>)}
      </ul>
    </div>
    <div class="wrap">
      <ul role="list" class="facts">
        <li><span class="mono">Gegründet</span>{firma.gruendung} in Berlin</li>
        <li><span class="mono">Leistungen</span>12 Gewerke, ein Ansprechpartner</li>
        <li><span class="mono">Für</span>Privat, Gewerbe, Hausverwaltungen</li>
        <li><span class="mono">Mitglied</span>Handwerkskammer Berlin · BG BAU</li>
      </ul>
    </div>
  </section>

  <!-- ═════════ INTRO ═════════ -->
  <section class="section intro" aria-labelledby="intro-title">
    <div class="wrap intro__grid">
      <div class="intro__side">
        <h2 id="intro-title" class="label">Wer wir sind</h2>
        <ul role="list" class="intro__roles" data-reveal>
          {firma.team.map((r, i) => (
            <li><span class="mono">0{i + 1}</span>{r}</li>
          ))}
        </ul>
      </div>
      <div>
        <p class="intro__text" data-reveal>{intro}</p>
        <div class="intro__links" data-reveal>
          <a href="/ueber-uns/" class="arrow-link">Mehr über TPM <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
    {foto.src && (
      <div class="wrap">
        <figure class="intro__foto" data-reveal-clip>
          <Picture
            src={foto.src}
            alt={foto.alt}
            formats={['avif', 'webp']}
            widths={[480, 800, 1200, 1600].filter((w) => w <= foto.src!.width)}
            sizes="(min-width: 1000px) 60vw, 100vw"
          />
          <figcaption class="mono">Team TPM · Berlin</figcaption>
        </figure>
      </div>
    )}
  </section>

  <!-- ═════════ LEISTUNGEN ═════════ -->
  <section class="section section--flush-top services" aria-labelledby="services-title">
    <div class="wrap">
      <div class="services__head">
        <p class="label">Leistungen</p>
        <Split as="h2" id="services-title" class="h2" text="Zwölf Gewerke.|*Ein Ansprechpartner.*" />
        <p class="services__lead muted" data-reveal>
          Einzeln beauftragt oder als Gesamtpaket: Wir stimmen die Gewerke aufeinander ab, damit Ihr Vorhaben ohne
          Leerlauf und doppelte Wege vorankommt.
        </p>
      </div>
      <ServiceIndex />
    </div>
  </section>

  <!-- ═════════ ZIELGRUPPEN ═════════ -->
  <section class="section audiences on-ink" aria-labelledby="aud-title">
    <div class="wrap">
      <p class="label">Für wen wir arbeiten</p>
      <Split as="h2" id="aud-title" class="h2 audiences__title" text="Zwei Auftraggeber.|*Ein Anspruch.*" />
      <div class="audiences__grid">
        <article class="aud" data-reveal>
          <div class="aud__axis" aria-hidden="true">A</div>
          <TradeDrawing slug="innenausbau" class="aud__drawing" />
          <h3 class="h3">Privatkunden</h3>
          <p class="muted">
            Sie sanieren Ihre Wohnung, renovieren vor dem Einzug oder brauchen kurzfristig Hilfe bei einem Schaden.
            Wir übernehmen die Arbeiten und koordinieren alle Gewerke, damit Sie sich nicht um jeden Handwerker
            einzeln kümmern müssen.
          </p>
          <ul role="list" class="aud__list">
            <li>Sanierung und Modernisierung</li>
            <li>Renovierung vor Ein- oder Auszug</li>
            <li>Badsanierung</li>
            <li>Hilfe bei akuten Schäden</li>
          </ul>
          <a href="/anfrage/?kunde=privat" class="arrow-link">Anfrage als Privatkunde <Icon name="arrow" /></a>
        </article>
        <article class="aud" data-reveal>
          <div class="aud__axis" aria-hidden="true">B</div>
          <TradeDrawing slug="trockenbau" class="aud__drawing" />
          <h3 class="h3">Gewerbe &amp; Hausverwaltungen</h3>
          <p class="muted">
            Sie betreuen Bestandsobjekte, bauen Gewerbeflächen aus oder brauchen einen verlässlichen Partner für
            laufende Instandhaltung. Bauleiter und Projektmanager steuern die Arbeiten und halten Sie auf dem
            Laufenden.
          </p>
          <ul role="list" class="aud__list">
            <li>Ausbau von Büro-, Laden- und Gastronomieflächen</li>
            <li>Instandsetzung bei Mieterwechsel</li>
            <li>Laufende Kleinreparaturen</li>
            <li>Rückbau und Entrümpelung</li>
          </ul>
          <a href="/gewerbe/" class="arrow-link">Mehr für Gewerbekunden <Icon name="arrow" /></a>
        </article>
      </div>
    </div>
  </section>

  <!-- ═════════ WERTE ═════════ -->
  <section class="section values on-blue" aria-labelledby="values-title">
    <div class="wrap">
      <p class="label">Wofür wir stehen</p>
      <h2 id="values-title" class="h2 values__title" data-reveal>Drei Werte, an denen Sie uns messen können.</h2>
      <ol role="list" class="values__list">
        {firma.werte.map((w, i) => (
          <li class="value" data-reveal>
            <span class="value__nr mono">0{i + 1}</span>
            <h3 class="value__title">{w.titel}</h3>
            {'zusatz' in w && <p class="value__add">{w.zusatz}</p>}
            <p class="value__text">{w.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ═════════ ABLAUF ═════════ -->
  <section class="section process" aria-labelledby="process-title">
    <div class="wrap process__grid">
      <div class="process__head">
        <p class="label">Ablauf</p>
        <Split as="h2" id="process-title" class="h2" text="Vom Erstkontakt|bis zur *Abnahme.*" />
        <p class="muted process__lead" data-reveal>
          So läuft ein Auftrag bei uns ab. Sie wissen bei jedem Schritt, was als Nächstes passiert und wer
          zuständig ist.
        </p>
        <a href="/anfrage/" class="btn process__cta" data-reveal>Schritt 1 starten <Icon name="arrow" /></a>
      </div>
      <div class="steps-wrap">
      <ol role="list" class="steps">
        {ablauf.map((s, i) => (
          <li class="step">
            <span class="step__nr mono">0{i + 1}</span>
            <div>
              <h3 class="h3">{s.titel}</h3>
              <p class="muted">{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
      </div>
    </div>
  </section>

  <!-- ═════════ KUNDENSTIMMEN ═════════ -->
  <Quotes />

</Base>

<style>
  /* ── Auftraggeber ── */
  .clients__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 2.25rem;
    margin: 0;
    font-size: clamp(1.05rem, 1.6vw, 1.35rem);
    font-weight: 620;
    font-stretch: 108%;
    color: rgba(243, 241, 236, 0.9);
  }
  .clients {
    padding-block: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--line-light);
  }
  .clients__head {
    margin-bottom: 1.75rem;
  }
  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem 1.5rem;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-light);
    font-size: 0.9rem;
    line-height: 1.35;
  }
  .facts li {
    display: grid;
    gap: 0.3rem;
  }
  .facts .mono {
    color: var(--sky);
    font-size: 0.66rem;
  }
  @media (min-width: 900px) {
    .facts {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .intro__foto {
    margin: clamp(3rem, 6vw, 5rem) 0 0 auto;
    width: fit-content;
    max-width: 100%;
    border: 1px solid var(--line-strong);
    padding: 0.6rem;
    background: var(--paper-2);
    overflow: hidden;
  }
  .intro__foto :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 80svh;
  }
  .intro__foto figcaption {
    margin-top: 0.6rem;
    color: var(--muted);
    font-size: 0.65rem;
  }

  /* ── Intro ── */
  .intro__grid {
    display: grid;
    gap: 2.5rem;
  }
  .intro__roles {
    margin-top: 2rem;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }
  .intro__roles li {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
    font-weight: 600;
    font-stretch: 110%;
  }
  .intro__roles .mono {
    color: var(--blue);
  }
  .intro__text {
    font-size: clamp(1.3rem, 2.3vw, 2.05rem);
    line-height: 1.18;
    font-weight: 560;
    font-stretch: 106%;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }
  .intro__links {
    margin-top: 2.5rem;
  }
  @media (min-width: 1000px) {
    .intro__grid {
      grid-template-columns: 1fr 2.6fr;
      gap: 5rem;
    }
  }

  /* ── Leistungen ── */
  .section--flush-top {
    padding-top: 0;
  }
  .services__head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }
  .services__lead {
    max-width: 46ch;
  }
  @media (min-width: 1000px) {
    .services__head {
      grid-template-columns: 1.6fr 1fr;
      align-items: end;
    }
    .services__head .label {
      grid-column: 1 / -1;
    }
  }

  /* ── Zielgruppen ── */
  .audiences__title {
    margin-top: 1.25rem;
  }
  .audiences__grid {
    margin-top: clamp(3rem, 6vw, 5rem);
    display: grid;
    border-top: 1px solid var(--line-light);
  }
  .aud {
    position: relative;
    display: grid;
    gap: 1.25rem;
    align-content: start;
    padding: 2.5rem 0 3rem;
    border-bottom: 1px solid var(--line-light);
  }
  .aud__axis {
    position: absolute;
    top: 2.5rem;
    right: 0;
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--line-light-strong);
    border-radius: 50%;
    font-family: var(--font-mono);
    color: var(--sky);
  }
  .aud__drawing {
    width: 7rem;
    color: var(--paper);
    --trade-bg: var(--ink);
    --trade-sw: 1.6;
    margin-bottom: 0.5rem;
  }
  .aud .muted {
    max-width: 52ch;
  }
  .aud__list {
    margin: 0.5rem 0 1rem;
    display: grid;
    gap: 0;
  }
  .aud__list li {
    padding: 0.7rem 0 0.7rem 1.6rem;
    border-top: 1px solid var(--line-light);
    position: relative;
  }
  .aud__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.25rem;
    width: 0.8rem;
    height: 1px;
    background: var(--sky);
  }
  .aud .arrow-link {
    justify-self: start;
  }
  @media (min-width: 900px) {
    .audiences__grid {
      grid-template-columns: 1fr 1fr;
      border-bottom: 1px solid var(--line-light);
    }
    .aud {
      padding: 3.5rem 4rem 3.5rem 0;
      border-bottom: 0;
    }
    .aud + .aud {
      padding-left: 4rem;
      padding-right: 0;
      border-left: 1px solid var(--line-light);
    }
    .aud__axis {
      right: 3rem;
      top: 3.5rem;
    }
    .aud + .aud .aud__axis {
      right: 0;
    }
  }

  /* ── Werte ── */
  .values__title {
    margin-top: 1.25rem;
    max-width: 22ch;
  }
  .values__list {
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    display: grid;
    gap: 0;
    border-top: 1px solid rgba(243, 241, 236, 0.3);
  }
  .value {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: 2rem 0;
    border-bottom: 1px solid rgba(243, 241, 236, 0.3);
  }
  .value__nr {
    color: var(--paper);
  }
  .value__title {
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    line-height: 1;
    font-weight: 760;
    font-stretch: 110%;
    letter-spacing: -0.025em;
  }
  .value__add {
    font-weight: 600;
    color: var(--paper);
  }
  .value__text {
    max-width: 40ch;
    color: rgba(243, 241, 236, 0.92);
  }
  @media (min-width: 900px) {
    .values__list {
      grid-template-columns: repeat(3, 1fr);
    }
    .value {
      padding: 2.25rem 2rem 2.25rem 0;
      border-bottom: 0;
    }
    .value + .value {
      padding-left: 2rem;
      border-left: 1px solid rgba(243, 241, 236, 0.3);
    }
  }

  /* ── Ablauf ── */
  .process__grid {
    display: grid;
    gap: 3rem;
  }
  .process__head .h2 {
    margin-top: 1.25rem;
  }
  .process__lead {
    margin-top: 1.5rem;
    max-width: 40ch;
  }
  .process__cta {
    margin-top: 2rem;
  }
  .steps-wrap {
    position: relative;
  }
  .steps {
    position: relative;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .steps::before {
    content: '';
    position: absolute;
    left: 1.25rem;
    top: 2.75rem;
    bottom: 3rem;
    width: 1px;
    background: var(--line-strong);
  }
  .step {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1.25rem;
    padding: 1.5rem 0 2rem;
  }
  .step__nr {
    position: relative;
    z-index: 1;
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--paper);
    border: 1px solid var(--line-strong);
    color: var(--muted);
    transition:
      background-color 0.4s var(--ease),
      color 0.4s var(--ease),
      border-color 0.4s var(--ease);
  }
  .step__nr {
    background: var(--blue);
    border-color: var(--blue);
    color: var(--paper);
  }
  .step .h3 {
    margin: 0.3rem 0 0.6rem;
  }
  .step .muted {
    max-width: 46ch;
  }
  @media (min-width: 1000px) {
    .process__grid {
      grid-template-columns: 1fr 1.15fr;
      gap: 6rem;
      align-items: start;
    }
    .process__head {
      position: sticky;
      top: calc(var(--header-h) + 3rem);
    }
  }

</style>

---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { firma } from '../data/firma';

interface Props {
  title: string;
  description: string;
  /** zusätzliche schema.org-Objekte (JSON-LD) */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  ogImage?: string;
  /** Footer ohne großen Anfrage-Aufruf (z. B. auf der Anfrage-Seite) */
  compactFooter?: boolean;
}

const { title, description, schema = [], noindex = false, ogImage = '/og.png', compactFooter = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title.includes('TPM') ? title : `${title} | TPM Bau GmbH`;

const business = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  '@id': `${firma.url}/#unternehmen`,
  name: firma.name,
  alternateName: `TPM – ${firma.langname}`,
  slogan: firma.leitsatz.join(' – '),
  url: `${firma.url}/`,
  logo: `${firma.url}/logo.png`,
  image: `${firma.url}/og.png`,
  telephone: firma.telefon.replace(/\s/g, ''),
  email: firma.email,
  foundingDate: String(firma.gruendung),
  founder: { '@type': 'Person', name: firma.geschaeftsfuehrer },
  address: {
    '@type': 'PostalAddress',
    streetAddress: firma.adresse.strasse,
    postalCode: firma.adresse.plz,
    addressLocality: firma.adresse.ort,
    addressCountry: firma.adresse.land,
  },
  areaServed: { '@type': 'City', name: 'Berlin' },
  memberOf: firma.mitgliedschaften.map((name) => ({ '@type': 'Organization', name })),
  sameAs: firma.social.map((s) => s.url).filter(Boolean),
};
const jsonLd = [business, ...schema];
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0a1626" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="TPM Bau GmbH" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href="/fonts/archivo-var.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>
      // Animationen nur aktivieren, wenn JS läuft und keine reduzierte Bewegung gewünscht ist.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          d.classList.add('motion');
          // Sicherheitsnetz: Lädt das Animationsskript nicht, wird alles sichtbar.
          setTimeout(function () {
            if (!d.classList.contains('motion-ready')) d.classList.remove('motion');
          }, 3500);
        }
      })();
    </script>

    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <Header />
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
    <Footer compact={compactFooter} />
    <MobileBar />

    <script>
      import '../scripts/ui';
      import '../scripts/motion';
    </script>
  </body>
</html>

---
// Eigene Strichzeichnungen im Planstil, eine pro Gewerk.
// Linien mit data-stroke zeichnen sich beim Erscheinen selbst (siehe scripts/motion.ts).
interface Props {
  slug: string;
  class?: string;
  /** Zeichnen-Animation beim Scrollen */
  animate?: boolean;
}
const { slug, class: klasse, animate = true } = Astro.props;
const id = `h-${slug}-${Math.random().toString(36).slice(2, 7)}`;
---
<svg
  class:list={['trade', klasse]}
  viewBox="0 0 120 120"
  fill="none"
  aria-hidden="true"
  data-draw={animate ? '' : undefined}
>
  <defs>
    <pattern id={id} width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="5" class="hatch" />
    </pattern>
  </defs>

  {slug === 'innenausbau' && (
    <g>
      <path class="aux" d="M50 78 L36 110 M60 78 V110 M70 78 L84 110 M40 56 H24" />
      <path d="M40 34 H80 V78 H40 Z" />
      <path d="M10 10 L40 34 M110 10 L80 34 M10 110 L40 78 M110 110 L80 78" />
      <path d="M52 78 V50 H67 V78" />
      <path d="M17 44 L30 50 V68 L17 66 Z" />
      <path class="aux" d="M23.5 47 V67" />
      <circle cx="63.5" cy="65" r="1.2" />
    </g>
  )}

  {slug === 'trockenbau' && (
    <g>
      <path d="M12 18 H108 M12 24 H108 M12 96 H108 M12 102 H108" />
      <path d="M18 24 V96 M23 24 V96 M46 24 V96 M51 24 V96 M74 24 V96 M79 24 V96 M102 24 V96 M107 24 V96" />
      <rect x="60" y="24" width="48" height="72" class="mask" />
      <rect x="60" y="24" width="48" height="72" fill={`url(#${id})`} />
      <path d="M84 24 V96" />
      <path class="aux" d="M18 110 H46 M18 106 V114 M46 106 V114 M46 110 H74 M74 106 V114" />
      <g class="dot">
        <circle cx="76.5" cy="34" r="1" /><circle cx="76.5" cy="52" r="1" /><circle cx="76.5" cy="70" r="1" /><circle cx="76.5" cy="88" r="1" />
      </g>
    </g>
  )}

  {slug === 'malerarbeiten' && (
    <g>
      <path d="M8 58 H44 V112 H8" fill={`url(#${id})`} class="aux" />
      <rect x="24" y="20" width="60" height="22" rx="4" class="mask" />
      <rect x="24" y="20" width="60" height="22" rx="4" />
      <path class="aux" d="M34 20 V42 M44 20 V42 M54 20 V42 M64 20 V42 M74 20 V42" />
      <path d="M84 31 H94 Q98 31 98 35 V50 Q98 54 94 54 H64 Q60 54 60 58 V70" />
      <rect x="54" y="70" width="12" height="40" rx="4" />
      <path d="M54 79 H66" />
    </g>
  )}

  {slug === 'putz-und-spachtelarbeiten' && (
    <g>
      <path class="aux" d="M10 96 q8 -5 16 0 t16 0 t16 0 t16 0 t16 0 t16 0 M10 106 q8 -5 16 0 t16 0 t16 0 t16 0 t16 0 t16 0" />
      <path d="M14 82 L106 82 L100 72 L20 72 Z" />
      <path d="M52 72 V58 H68 V72" />
      <rect x="38" y="36" width="44" height="16" rx="8" />
      <path d="M60 52 V58" />
      <path class="aux" d="M14 88 H106 M14 86 V90 M106 86 V90" />
    </g>
  )}

  {slug === 'bodenlegearbeiten' && (
    <g>
      <path d="M12 26 H106 M12 43 H106 M12 60 H106 M12 77 H106 M12 94 H106 M12 26 V94 M106 26 V94" />
      <path d="M44 26 V43 M84 26 V43 M28 43 V60 M64 43 V60 M98 43 V60 M50 60 V77 M90 60 V77 M34 77 V94 M72 77 V94" />
      <rect x="64" y="43" width="34" height="17" fill={`url(#${id})`} class="aux" />
      <path class="aux" d="M114 26 V94 M110 26 H118 M110 94 H118 M12 104 H106 M12 100 V108 M106 100 V108" />
    </g>
  )}

  {slug === 'fliesenlegearbeiten' && (
    <g>
      <path d="M16 16 h20 v20 h-20 Z M38 16 h20 v20 h-20 Z M60 16 h20 v20 h-20 Z M82 16 h20 v20 h-20 Z" />
      <path d="M16 38 h20 v20 h-20 Z M38 38 h20 v20 h-20 Z M82 38 h20 v20 h-20 Z" />
      <path d="M16 60 h20 v20 h-20 Z M38 60 h20 v20 h-20 Z M60 60 h20 v20 h-20 Z M82 60 h20 v20 h-20 Z" />
      <path d="M16 82 h20 v20 h-20 Z M38 82 h20 v20 h-20 Z M60 82 h20 v20 h-20 Z M82 82 h20 v20 h-20 Z" />
      <path class="aux" d="M60 38 h20 v20 h-20 Z" stroke-dasharray="2 3" />
      <g transform="rotate(-12 74 40)">
        <rect x="64" y="24" width="20" height="20" class="mask" />
        <rect x="64" y="24" width="20" height="20" fill={`url(#${id})`} />
        <rect x="64" y="24" width="20" height="20" class="accent-line" />
      </g>
    </g>
  )}

  {slug === 'tischlerarbeiten' && (
    <g>
      <path d="M28 106 V14 H82 V106" />
      <path d="M34 106 V20 H76 V106" />
      <path d="M41 28 h28 v28 h-28 Z M41 64 h28 v34 h-28 Z" />
      <path d="M68 60 H74" />
      <path d="M84 112 V60 H91 V105 H114 V112 Z" class="accent-line" />
      <path class="aux" d="M91 70 H95 M91 80 H95 M91 90 H95 M101 105 V101 M108 105 V101" />
      <path class="aux" d="M8 106 H22 M8 14 H22 M15 14 V106" />
    </g>
  )}

  {slug === 'elektroinstallation' && (
    <g>
      <circle cx="40" cy="16" r="8" />
      <path d="M34.3 10.3 L45.7 21.7 M45.7 10.3 L34.3 21.7" />
      <path class="aux" d="M40 24 V40 M40 84 V100 H89 V64" stroke-dasharray="3 3" />
      <rect x="18" y="40" width="44" height="44" rx="6" />
      <circle cx="40" cy="62" r="14" />
      <circle cx="35" cy="62" r="2.4" />
      <circle cx="45" cy="62" r="2.4" />
      <path d="M40 48.5 V51.5 M40 72.5 V75.5" />
      <rect x="74" y="34" width="30" height="30" rx="5" />
      <rect x="81" y="41" width="16" height="16" rx="2" />
      <path d="M81 49 H97" />
    </g>
  )}

  {slug === 'heizung-lueftung-sanitaer' && (
    <g>
      <path d="M12 28 H24 M36 28 H66 Q76 28 76 38 V108" />
      <path d="M12 46 H24 M36 46 H48 Q58 46 58 56 V108" />
      <path d="M24 22 L36 34 V22 L24 34 Z M24 40 L36 52 V40 L24 52 Z" class="accent-line" />
      <path d="M30 22 V12 M25 12 H35" />
      <rect x="88" y="52" width="22" height="44" rx="2" />
      <path d="M93.5 52 V96 M99 52 V96 M104.5 52 V96" class="aux" />
      <path d="M76 62 H88" />
      <path class="aux" d="M4 112 H116" />
      <path d="M67 86 c0 0 -5 6 -5 9 a5 5 0 0 0 10 0 c0 -3 -5 -9 -5 -9 Z" class="accent-line" />
    </g>
  )}

  {slug === 'abriss-und-entsorgung' && (
    <g>
      <path d="M12 106 V64 L22 58 L30 66 L40 54 L50 62 L58 52 L66 60 L76 56 V106" />
      <path class="aux" d="M12 74 H76 M12 90 H76 M4 106 H116 M28 64 V74 M52 59.5 V74 M20 74 V90 M44 74 V90 M68 74 V90 M32 90 V106 M56 90 V106" />
      <g transform="rotate(-25 87 22)">
        <rect x="70" y="14" width="34" height="16" rx="2" class="mask" />
        <rect x="70" y="14" width="34" height="16" rx="2" fill={`url(#${id})`} />
        <rect x="70" y="14" width="34" height="16" rx="2" />
        <rect x="84" y="30" width="6" height="64" rx="2" />
      </g>
      <path class="accent-line" d="M60 44 l5 -4 l2 5 z M70 34 l4 -2 l1 4 z M47 42 l3 -3 l2 3 z" />
    </g>
  )}

  {slug === 'entruempelung' && (
    <g>
      <rect x="28" y="36" width="24" height="22" />
      <path d="M28 44 H52 M40 36 V44" class="aux" />
      <path d="M62 58 L84 24 L90 28 L69 58" />
      <path d="M14 58 H106 L96 98 H24 Z" class="mask" />
      <path d="M14 58 H106 L96 98 H24 Z" />
      <path d="M10 58 H110" />
      <path class="aux" d="M19 66 H101 M21 76 H99 M23 86 H97" />
      <circle cx="20" cy="68" r="3" />
      <circle cx="100" cy="68" r="3" />
      <path class="aux" d="M4 104 H116" />
      <path class="accent-line" d="M100 14 V36 M94 30 L100 36 L106 30" />
    </g>
  )}

  {slug === 'kleinreparaturen' && (
    <g>
      <g transform="rotate(-40 62 58)">
        <path d="M24 53 H78.9 A14 14 0 0 1 105.1 53 H96 V63 H105.1 A14 14 0 0 1 78.9 63 H24 A5 5 0 0 1 24 53 Z" />
        <circle cx="30" cy="58" r="2.5" />
        <path class="aux" d="M40 58 H72" />
      </g>
      <g transform="rotate(18 90 96)">
        <path d="M80 84 H100 L96 90 H84 Z" class="accent-line" />
        <path d="M86 90 V108 L90 114 L94 108 V90" />
        <path class="aux" d="M86 94 L94 96 M86 98 L94 100 M86 102 L94 104" />
      </g>
    </g>
  )}
</svg>

<style>
  .trade {
    --trade-bg: var(--paper);
    color: currentColor;
    overflow: visible;
  }
  .trade :global(path),
  .trade :global(rect),
  .trade :global(circle),
  .trade :global(line) {
    stroke: currentColor;
    stroke-width: var(--trade-sw, 1.5);
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .trade :global(.aux) {
    stroke: var(--trade-aux, var(--sky));
    stroke-width: calc(var(--trade-sw, 1.5) * 0.7);
  }
  .trade :global(.accent-line) {
    stroke: var(--trade-accent, var(--blue));
  }
  .trade :global(.hatch) {
    stroke: var(--trade-aux, var(--sky));
    stroke-width: calc(var(--trade-sw, 1.5) * 0.55);
  }
  .trade :global(.mask) {
    fill: var(--trade-bg);
    stroke: none;
  }
  .trade :global(.dot circle) {
    fill: currentColor;
    stroke: none;
  }
</style>

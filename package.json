{
  "name": "tpm-bau-webseite",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "Webseite der TPM Bau GmbH, Berlin – statisch generiert mit Astro",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0 --port 4321",
    "serve": "node scripts/serve.mjs 4322",
    "check": "astro check",
    "check:livegang": "node scripts/check-livegang.mjs",
    "test:anfrage": "node scripts/test-anfrage.mjs",
    "test:anfrage:handy": "HANDY=1 node scripts/test-anfrage.mjs",
    "test:handy": "node scripts/test-handy.mjs",
    "test:vorschau": "node scripts/test-vorschau.mjs",
    "test:livegang": "node scripts/test-livegang.mjs",
    "check:overflow": "node scripts/check-overflow.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "screenshots": "node scripts/screenshots.mjs && node scripts/anfrage-shots.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "praesentation": "node scripts/praesentation.mjs",
    "paket:vorschau": "node scripts/paket-vorschau.mjs",
    "vorschau": "astro build && node scripts/vorschau-einzeln.mjs"
  },
  "dependencies": {
    "@astrojs/react": "~7.1.0",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "~7.4.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.66.0",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lighthouse": "^13.5.0",
    "playwright": "^1.56.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
